SanPham "1" -- "*" SanPhamSerial
ChiTietPhieuNhap "1" -- "*" SanPhamSerial
DonHang "1" -- "*" SanPhamSerial
DonHang "1" -- "*" PhieuXuat
SanPhamSerial "*" -- "*" PhieuXuat
DonHang "1" -- "*" YeuCauDoiTra
SanPhamSerial "*" -- "*" YeuCauDoiTra
SanPhamSerial "1" -- "*" PhieuBaoHanh
@enduml
