KhachHang "1" -- "*" DonHang
KhuyenMai "1" -- "*" DonHang
DonHang "1" -- "*" ChiTietDonHang
SanPham "1" -- "*" ChiTietDonHang
DonHang "1" -- "*" GiaoDichThanhToan
DonHang "1" -- "*" LichSuTrangThaiDon
SanPham "1" -- "*" DanhGia
KhachHang "1" -- "*" DanhGia
DonHang "1" -- "*" DanhGia
DonHang "1" -- "*" PhieuGiaoHang
PhieuGiaoHang "1" -- "0..1" PhieuLapDat
NhaCungCap "1" -- "*" DonDatHangNCC
DonDatHangNCC "1" -- "*" ChiTietDonDatHangNCC
SanPham "1" -- "*" ChiTietDonDatHangNCC
