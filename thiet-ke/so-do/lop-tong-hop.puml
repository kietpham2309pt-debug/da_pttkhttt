  class DonDatHangNCC
  class ChiTietDonDatHangNCC
  class PhieuNhap
  class ChiTietPhieuNhap
  class SanPhamSerial
  class PhieuXuat
  class PhieuBaoHanh
}
VaiTro "*" -- "*" TaiKhoan
TaiKhoan "1" -- "0..1" NhanVien
