@startuml lop-tong-hop
!pragma layout smetana
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 15
skinparam monochrome true
skinparam shadowing false
skinparam dpi 170
skinparam classAttributeIconSize 0
hide circle
skinparam defaultFontSize 14
hide members
package "G1 · Quản trị hệ thống" {
  class VaiTro
  class TaiKhoan
  class NhanVien
}
package "G2 · Sản phẩm và khuyến mãi" {
  class DanhMuc
  class ThuongHieu
  class SanPham
  class ThongSoKyThuat
  class LichSuGia
  class KhuyenMai
  class DanhGia
}
package "G3 · Mua hàng và thanh toán" {
  class KhachHang
  class DiaChiGiaoHang
  class DonHang
  class ChiTietDonHang
  class GiaoDichThanhToan
}
package "G4 · Đơn hàng, giao lắp, đổi trả" {
  class LichSuTrangThaiDon
  class PhieuGiaoHang
  class PhieuLapDat
  class YeuCauDoiTra
}
package "G5 · Kho, nhà cung cấp, bảo hành" {
